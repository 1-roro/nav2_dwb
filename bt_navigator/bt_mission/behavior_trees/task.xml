<!--
  작업 하나를 실행하는 미션 BT (BehaviorTree.CPP v3, Nav2 Humble)

    task_client.py ──(execute_task 액션: goal = Task)──▶ task_server ─▶ 이 트리를 처음부터 tick
                   ◀─ feedback (실행 중인 노드, 도착한 점 수), result (성공 여부, 이유) ─┘

  task_server 가 goal 을 받으면 blackboard 에 {waypoints} {task_id} {action} {duration} 을 쓰고 이 트리를
  끝날 때까지 tick 한다. 트리가 SUCCESS 면 goal 은 SUCCEEDED, FAILURE 면 ABORTED 가 된다.
  작업을 기다리고, 실패를 보고하고, 다음 작업을 받는 일은 서버가 하므로 트리에는 "한 작업을 어떻게 하나" 만 남는다.

  점마다 ForEachWaypoint 가 NavigateToPose 를 한 번씩 보낸다. 로봇은 점마다 멈춰서 위치와 방향을 맞추고,
  도착을 알린 뒤 다음 점으로 간다.

    action       동작
    go (그 외)   점을 차례로 들르기만
    inspect      점을 차례로 들른 뒤, 마지막 점에서 정지 상태로 duration 초 작업
    scan         점을 차례로 들르는 동안 0.5m 마다 스캔
    look_around  점을 차례로 들른 뒤, 마지막 점에서 제자리 한 바퀴
    dock         점을 차례로 들른 뒤(마지막 점 = dock 앞 staging 자리), {target} dock 의 ArUco marker 를 보고 도킹
                 (아래 Dock 트리, DOCKING.md)
    undock       점 없이, 그 자리에서 곧게 뒤로 빠져나온다 (아래 Undock 트리)
    undock_precise  점 없이, marker 를 보며 dock 축을 따라 물러나 정해진 자리에 선다 (아래 UndockPrecise 트리)

  장애물은 이 트리가 다루지 않는다. 길이 막히면 controller 가 그 앞에서 감속해서 서고(갑자기 나타나면
  collision_monitor 가 세운다), NavigateToPose 는 goal 을 그대로 둔 채 RUNNING 으로 기다린다 (README 6장).
-->
<root main_tree_to_execute="Task">

  <BehaviorTree ID="Task">
    <Switch6 name="by_action" variable="{action}"
             case_1="inspect" case_2="scan" case_3="look_around" case_4="dock" case_5="undock"
             case_6="undock_precise">
      <Sequence name="inspect">
        <ForEachWaypoint name="inspect_points" poses="{waypoints}" pose="{waypoint}"
                         reached="{waypoints_reached}" task_id="{task_id}">
          <NavigateToPose name="go_inspect" goal="{waypoint}"/>
        </ForEachWaypoint>
        <DoWork name="work" task="{task_id}" duration="{duration}"/>
      </Sequence>
      <Parallel name="scan" success_threshold="1" failure_threshold="1">
        <ForEachWaypoint name="scan_points" poses="{waypoints}" pose="{waypoint}"
                         reached="{waypoints_reached}" task_id="{task_id}">
          <NavigateToPose name="go_scan" goal="{waypoint}"/>
        </ForEachWaypoint>
        <ScanWhileMoving name="scanning" interval="0.5"/>
      </Parallel>
      <Sequence name="look_around">
        <ForEachWaypoint name="look_points" poses="{waypoints}" pose="{waypoint}"
                         reached="{waypoints_reached}" task_id="{task_id}">
          <NavigateToPose name="go_look" goal="{waypoint}"/>
        </ForEachWaypoint>
        <Spin name="spin" spin_dist="6.28" time_allowance="20" is_recovery="false"/>
      </Sequence>
      <Sequence name="dock">
        <ForEachWaypoint name="dock_points" poses="{waypoints}" pose="{waypoint}"
                         reached="{waypoints_reached}" task_id="{task_id}">
          <NavigateToPose name="go_staging" goal="{waypoint}"/>
        </ForEachWaypoint>
        <SubTree ID="Dock" __shared_blackboard="true"/>
      </Sequence>
      <SubTree ID="Undock" __shared_blackboard="true"/>
      <SubTree ID="UndockPrecise" __shared_blackboard="true"/>
      <ForEachWaypoint name="go_points" poses="{waypoints}" pose="{waypoint}"
                       reached="{waypoints_reached}" task_id="{task_id}">
        <NavigateToPose name="go_only" goal="{waypoint}"/>
      </ForEachWaypoint>
    </Switch6>
  </BehaviorTree>

  <!--
  도킹 (DOCKING.md). 위 Task 트리의 dock, undock, undock_precise 가지가 SubTree 로 부른다.
  (따로 파일로 두고 <include> 하면 task_server 는 되지만, task_server_lifecycle 이 쓰는 Nav2 BtActionServer 는
   XML 을 글자로 읽어서 상대 경로를 찾지 못한다. 그래서 한 파일에 둔다)

  이 XML 에는 "무엇을 어떤 순서로" 만 있다. 값(속도, 허용오차, 거리, 로봇 치수, 토픽)은 모두
  config/docking.yaml 에 있고, 노드는 stage 이름으로 자기 값을 찾는다 (stages.approach, stages.insert, ...).
  실제 로봇으로 옮길 때는 docking.yaml 만 고친다.

    dock            작업의 마지막 점(설비 앞에서 marker 가 보이는 staging 자리)에 Nav2 로 간 뒤 Dock 트리
    undock          Undock 트리 (점 없음): 곧게 뒤로
    undock_precise  UndockPrecise 트리 (점 없음): marker 를 보며 뒤로

  카메라 영상의 marker 는 aruco_detector.py 가 찾아 dock/aruco 로 보낸다 (바닥 위 자세 후보 + 공분산).
  설 곳: ~/.ros/aruco_taught/<dock>.yaml (aruco_teach.py 로 가르친 자세) 이 있으면 그것, 없으면 도면 값
  (로봇 앞면이 도킹 면에서 docks.<dock>.gap).
  -->
  <BehaviorTree ID="Dock">
    <Sequence name="dock">
      <!-- 지금 자리(staging)에서 marker 를 찾는다. 안 보이면 레이저로 주변을 확인하고 제자리에서 돌며 찾는다.
           dock 의 자리(odom)와 설 곳을 잡는다. 여기서 못 찾으면 작업 실패 (로그에 이유) -->
      <DetectArucoDock name="find_marker" target="{target}" state="{aruco_dock}"/>
      <!-- 들어가다 실패하면(marker 를 놓침 등) 뒤로 물러나지 않는다 (뒤에 무엇이 있을지 모른다).
           그 자리에 서서 marker 를 다시 보고, 지금 자리에서 이어서 들어간다. 3번까지 -->
      <RetryUntilSuccessful num_attempts="3">
        <Fallback name="dock_or_look_again">
          <Sequence name="dock_attempt">
            <!-- 설 곳 0.25 m 앞까지. 옆과 방향을 깔때기 안으로 맞춘다. collision_monitor 는 켠 채.
                 다시 시도할 때 이미 그보다 가까우면 뒤로 가지 않고 넘어간다 -->
            <ArucoServo name="approach" stage="approach" state="{aruco_dock}"/>
            <!-- 설비는 붙어야 하는 물체라 collision_monitor 를 끄고 -->
            <MuteCollisionMonitor name="mute_safety" polygon="Footprint">
              <Sequence name="insert_refine">
                <!-- 마지막 0.25 m 를 느리게. marker 를 방금 보았고 화면 안쪽에 있을 때만 설비 쪽으로 간다 -->
                <ArucoServo name="insert" stage="insert" state="{aruco_dock}"/>
                <!-- 서서 재고 고치기: 움직이며 본 것의 늦음, 흔들림, 미끄러짐을 지운다 -->
                <ArucoRefine name="refine" stage="refine" state="{aruco_dock}"/>
              </Sequence>
            </MuteCollisionMonitor>
          </Sequence>
          <!-- 그 자리에 서서 다시 본다 (돌지 않는다: 설비 가까이일 수 있다). 그리고 다음 시도 -->
          <ForceFailure>
            <DetectArucoDock name="look_again" target="{target}" state="{aruco_dock}" search="false"/>
          </ForceFailure>
        </Fallback>
      </RetryUntilSuccessful>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="Undock">
    <!-- 단순 undock: 지금 방향 그대로 곧게 뒤로 (docking.yaml 의 undock). 뒤는 레이저로 확인한다.
         설비가 collision_monitor 의 원 안에 있으므로 끄고 물러난다. 다 물러나면 다시 켜진다 -->
    <MuteCollisionMonitor name="mute_safety_undock" polygon="Footprint">
      <BackOff name="undock"/>
    </MuteCollisionMonitor>
  </BehaviorTree>

  <BehaviorTree ID="UndockPrecise">
    <!-- 정밀 undock: 붙은 자리에서 marker 를 보고(돌지 않는다) dock 의 자리를 잡은 뒤, dock 축을 따라
         옆과 방향을 맞추며 물러나 "붙은 자리 + stages.retreat.standoff" 에 선다. 바퀴가 미끄러져도 선 자리가
         설비 기준으로 정해진다. 뒤는 레이저로 확인한다. marker 가 안 보이면 단순 undock 으로 -->
    <MuteCollisionMonitor name="mute_safety_undock_precise" polygon="Footprint">
      <IfThenElse name="marker_visible">
        <DetectArucoDock name="find_marker_undock" target="{target}" state="{aruco_dock}" search="false"/>
        <ArucoServo name="retreat" stage="retreat" state="{aruco_dock}"/>
        <BackOff name="undock_without_marker"/>
      </IfThenElse>
    </MuteCollisionMonitor>
  </BehaviorTree>
</root>
