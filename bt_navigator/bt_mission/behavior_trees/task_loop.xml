<!--
  토픽으로 받은 작업을 하나씩 실행하는 미션 BT (BehaviorTree.CPP v3, Nav2 Humble)

    task_sender.py ──(mission/task: bt_mission_msgs/Task)──▶ WaitForTask ─▶ 이동 + 작업
                   ◀─(mission/status: std_msgs/String)────── WaitForTask, Log

  bt_old_mission 의 mission.xml 과 달리 좌표가 XML 에 없다. 위치와 할 일은 Task 메시지가 정하고,
  BT 는 "작업을 받으면 action 에 따라 어떻게 움직이고 무엇을 할지" 만 정한다.
  점마다 ForEachWaypoint 가 NavigateToPose 를 한 번씩 보낸다. 로봇은 점마다 멈춰서 위치와 방향을 맞추고,
  도착을 알린 뒤("t1 arrived 1/3") 다음 점으로 간다.

    action       동작
    go (그 외)   점을 차례로 들르기만
    inspect      점을 차례로 들른 뒤, 마지막 점에서 정지 상태로 duration 초 작업
    scan         점을 차례로 들르는 동안 0.5m 마다 스캔
    look_around  점을 차례로 들른 뒤, 마지막 점에서 제자리 한 바퀴

  장애물 (작업의 obstacle 값. 맨 앞의 ObstacleMode 가 {stop_and_go} 와 {nav_bt} 로 바꾼다)

    obstacle      동작
    stop (기본)   StopAndGo 가 레이저로 로봇 앞길을 본다. 막히면 NavigateToPose 를 멈추고(goal 취소) 기다리다가,
                  길이 1초 동안 비어 있으면 같은 점으로 다시 보낸다 (stop & go)
    avoid         StopAndGo 는 꺼진다. NavigateToPose 가 navigate_avoid.xml 을 보내서, bt_navigator 가
                  장애물을 보는 planner / controller (Avoid / FollowPathAvoid) 로 돌아간다
    none          장애물을 보지 않는다

  작업 하나가 실패해도 보고만 하고 다음 작업을 기다린다. 스스로 끝나지 않으므로 Ctrl-C 로 멈춘다.

  실행: mission_bt_runner 의 bt_xml 파라미터를 task_loop.xml 로 준다 (bt_navigator/README.md 참고)
-->
<root main_tree_to_execute="TaskLoop">
  <BehaviorTree ID="TaskLoop">
    <KeepRunningUntilFailure name="loop">
      <Sequence name="one_task">

        <!-- 1. 작업이 올 때까지 기다렸다가 내용을 blackboard 에 꺼내 둔다 -->
        <WaitForTask name="wait_task" waypoints="{waypoints}" task_id="{task_id}"
                     action="{action}" duration="{duration}" obstacle="{obstacle}"/>

        <!-- 2. action 에 맞는 이동과 작업. 실패하면 보고하고 다음 작업으로 -->
        <Fallback name="run_task">
          <Sequence name="try_task">
            <Log name="report_start" task_id="{task_id}" message="started"/>
            <ObstacleMode name="obstacle_mode" mode="{obstacle}" avoid_bt="navigate_avoid.xml"
                          stop_and_go="{stop_and_go}" nav_bt="{nav_bt}"/>
            <Switch3 name="by_action" variable="{action}"
                     case_1="inspect" case_2="scan" case_3="look_around">
              <Sequence name="inspect">
                <ForEachWaypoint name="inspect_points" poses="{waypoints}" pose="{waypoint}"
                                 task_id="{task_id}">
                  <StopAndGo name="stop_go" enabled="{stop_and_go}" goal="{waypoint}"
                             blocked="{blocked}" task_id="{task_id}">
                    <NavigateToPose name="go_inspect" goal="{waypoint}" behavior_tree="{nav_bt}"/>
                  </StopAndGo>
                </ForEachWaypoint>
                <DoWork name="work" task="{task_id}" duration="{duration}"/>
              </Sequence>
              <Parallel name="scan" success_threshold="1" failure_threshold="1">
                <ForEachWaypoint name="scan_points" poses="{waypoints}" pose="{waypoint}"
                                 task_id="{task_id}">
                  <StopAndGo name="stop_go" enabled="{stop_and_go}" goal="{waypoint}"
                             blocked="{blocked}" task_id="{task_id}">
                    <NavigateToPose name="go_scan" goal="{waypoint}" behavior_tree="{nav_bt}"/>
                  </StopAndGo>
                </ForEachWaypoint>
                <ScanWhileMoving name="scanning" interval="0.5"/>
              </Parallel>
              <Sequence name="look_around">
                <ForEachWaypoint name="look_points" poses="{waypoints}" pose="{waypoint}"
                                 task_id="{task_id}">
                  <StopAndGo name="stop_go" enabled="{stop_and_go}" goal="{waypoint}"
                             blocked="{blocked}" task_id="{task_id}">
                    <NavigateToPose name="go_look" goal="{waypoint}" behavior_tree="{nav_bt}"/>
                  </StopAndGo>
                </ForEachWaypoint>
                <Spin name="spin" spin_dist="6.28" time_allowance="20" is_recovery="false"/>
              </Sequence>
              <ForEachWaypoint name="go_points" poses="{waypoints}" pose="{waypoint}"
                               task_id="{task_id}">
                <StopAndGo name="stop_go" enabled="{stop_and_go}" goal="{waypoint}"
                           blocked="{blocked}" task_id="{task_id}">
                  <NavigateToPose name="go_only" goal="{waypoint}" behavior_tree="{nav_bt}"/>
                </StopAndGo>
              </ForEachWaypoint>
            </Switch3>
            <Log name="report_done" task_id="{task_id}" message="done"/>
          </Sequence>
          <Log name="report_failed" task_id="{task_id}" message="failed"/>
        </Fallback>

      </Sequence>
    </KeepRunningUntilFailure>
  </BehaviorTree>
</root>
