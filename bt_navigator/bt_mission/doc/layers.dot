// 미션 BT 가 Nav2 의 어디에 붙는지 (dot -Tpng -Gdpi=110 layers.dot -o layers.png)
digraph layers {
  graph [rankdir=TB, fontname="NanumGothic", bgcolor="white", pad=0.3, nodesep=0.4, ranksep=0.7,
         newrank=true, labelloc=b, label=<<table border="0" cellspacing="0" cellpadding="4"><tr>
           <td bgcolor="#fbdccf" border="1" color="#eb6834">&nbsp;이 저장소의 코드&nbsp;</td><td>&nbsp;&nbsp;</td>
           <td bgcolor="#cde2fb" border="1" color="#2a78d6">&nbsp;Nav2 가 제공&nbsp;</td></tr></table>>];
  node [shape=box, style="rounded,filled", fontname="NanumGothic", fontsize=12, fontcolor="#0b0b0b",
        penwidth=1.5, margin="0.15,0.08"];
  edge [color="#8a8984", penwidth=1.3, fontname="NanumGothic", fontsize=10, fontcolor="#52514e"];

  // 왼쪽 열: 계층 이름
  node [shape=plaintext, style="", fontsize=12, fontcolor="#52514e", margin=0];
  L0 [label=<<b>입력</b> (4장)<br/>어디로, 무엇을>];
  L1 [label=<<b>상위 작업 계층</b><br/>무엇을, 어떤 순서로,<br/>실패하면 어떻게>];
  L2 [label=<<b>bt_navigator</b><br/>goal 까지 어떻게 갈지<br/>(내부 BT: 재계획, recovery)>];
  L3 [label=<<b>서버</b><br/>경로 계산, 경로 추종,<br/>제자리 동작>];
  L4 [label=<<b>속도 관문</b> (6장)<br/>앞이 막히면 0 속도>];
  L5 [label=""];
  L0 -> L1 -> L2 -> L3 -> L4 -> L5 [style=invis];

  node [shape=box, style="rounded,filled", fontsize=12, fontcolor="#0b0b0b", margin="0.15,0.08"];
  ts [label=<<b>task_client.py</b><br/><font point-size="10">또는 관제 서버, ros2 action send_goal</font>>,
      fillcolor="#fbdccf", color="#eb6834"];
  bt [label=<<b>task_server</b> 또는 <b>task_server_lifecycle</b><br/>task.xml<br/><font point-size="10">BehaviorTree.CPP v3</font>>,
      fillcolor="#fbdccf", color="#eb6834"];
  nt [label=<<b>navigate_to_pose</b><br/><font point-size="10">한 점까지 가서 정지</font>>,
      fillcolor="#cde2fb", color="#2a78d6"];
  planner [label=<<b>planner_server</b><br/><font point-size="10">GridBased = SimpleLinePlanner (이 저장소)</font>>,
           fillcolor="#cde2fb", color="#2a78d6"];
  controller [label=<<b>controller_server</b><br/><font point-size="10">FollowPath = SimpleLineController (이 저장소)</font>>,
              fillcolor="#cde2fb", color="#2a78d6"];
  behavior [label=<<b>behavior_server</b><br/><font point-size="10">spin, wait, backup ...</font>>,
            fillcolor="#cde2fb", color="#2a78d6"];
  cm [label=<<b>collision_monitor</b><br/><font point-size="10">StopZone 에 레이저 점이 있으면 0 을 보낸다<br/>(설정: simple_line_params.yaml)</font>>,
      fillcolor="#cde2fb", color="#2a78d6"];
  robot [label=<<b>로봇</b><br/><font point-size="10">/cmd_vel_safe 를 받아 움직인다</font>>,
         fillcolor="#f0efec", color="#52514e"];
  laser [label=<<b>레이저</b><br/><font point-size="10">/scan</font>>,
         fillcolor="#f0efec", color="#52514e"];

  {rank=same; L0; ts}
  {rank=same; L1; bt}
  {rank=same; L2; nt}
  {rank=same; L3; planner; controller; behavior}
  {rank=same; L4; cm; laser}
  {rank=same; L5; robot}
  L0 -> ts [style=invis];
  L1 -> bt [style=invis];
  L2 -> nt [style=invis];
  L3 -> planner -> controller -> behavior [style=invis];

  ts -> bt [label=" execute_task 액션\l (goal, cancel)\l"];
  bt -> ts [style=dashed, label=" feedback, result\l"];
  bt -> nt [label=" NavigateToPose\l (점마다 한 번)\l"];
  bt -> behavior [label=" Spin"];
  nt -> planner [label=" ComputePath\l ToPose\l"];
  nt -> controller [label=" FollowPath"];
  controller -> cm [label=" /cmd_vel_nav → velocity_smoother\l → /cmd_vel\l"];
  behavior -> cm [label=" /cmd_vel"];
  laser -> cm [label=" /scan"];
  cm -> robot [label=" /cmd_vel_safe"];
}
