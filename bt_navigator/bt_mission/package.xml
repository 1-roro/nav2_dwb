<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bt_mission</name>
  <version>0.1.0</version>
  <description>Mission BTs on Nav2 Humble that take tasks at run time: a BT runner (tasks from a topic), ExecuteTask action servers (plain and nav2_behavior_tree::BtActionServer versions), BT nodes, and task senders.</description>
  <maintainer email="user@example.com">nav2_dwb</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>behaviortree_cpp_v3</depend>
  <depend>nav2_behavior_tree</depend>
  <depend>geometry_msgs</depend>
  <depend>lifecycle_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>ament_index_cpp</depend>
  <depend>std_msgs</depend>
  <depend>bt_mission_msgs</depend>
  <depend>nav2_util</depend>
  <depend>rclcpp_lifecycle</depend>

  <exec_depend>simple_line_bringup</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
