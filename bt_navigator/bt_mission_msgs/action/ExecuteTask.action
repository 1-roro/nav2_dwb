# task_server 에 맡기는 작업 하나. 액션 이름: execute_task
#
# 로봇은 task.waypoints 의 점마다 멈춰서 위치와 방향을 맞추고(도착), 차례로 다음 점으로 간다.
# 마지막 점에 도착하면 task.action 에 따라 작업한다.
# 작업 중에 새 goal 이 오면 지금 작업을 멈추고(ABORTED) 새 작업을 시작한다.

# ---- goal ----
Task task                     # 작업 내용 (Task.msg: id, waypoints, action, duration)
---
# ---- result ----
bool success
string message                # "done", 또는 실패/중단 이유
                              # ("go_inspect failed at waypoint 2/3", "preempted by t2", "canceled")
string bt_status              # 트리(task.xml 의 루트)가 마지막으로 돌려준 상태. 아래 중 하나
string BT_SUCCESS = "SUCCESS" #   작업을 끝냈다 (goal 상태 SUCCEEDED)
string BT_FAILURE = "FAILURE" #   실패했다 (ABORTED)
string BT_RUNNING = "RUNNING" #   끝나기 전에 멈췄다: 취소(CANCELED), 선점, 서버 종료(ABORTED)
string BT_IDLE = "IDLE"       #   한 번도 tick 하지 않았다
---
# ---- feedback ----
string task_id
string bt_status              # 트리(루트)의 상태. feedback 은 실행 중에만 오므로 RUNNING
string running                # 지금 RUNNING 인 액션 노드 (예: "go_scan, scanning")
uint32 waypoints_reached      # 지금까지 도착한 점 수 (0 ~ waypoints_total)
uint32 waypoints_total        # 이 작업의 점 수
float32 elapsed               # 작업 시작 후 지난 시간 [s]
