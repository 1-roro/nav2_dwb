<?xml version="1.0"?>
<!-- make_aruco_dock.py 가 만든 ArUco dock (dock_a, marker 0).
     원점 = 바닥에서 충전 접점 면의 가운데, +x = 방 쪽 (로봇이 다가오는 쪽), z = 위.
     충전대(높이 0.05 m)와 그 뒤 0.3 m 의 뒤판, 뒤판 앞면에 marker 판. 월드에서는 +x 가 방을 보게 놓는다 -->
<sdf version="1.6">
  <model name="aruco_dock">
    <static>true</static>
    <link name="body">
      <collision name="base_collision">
        <pose>-0.1500 0 0.0250 0 0 0</pose>
        <geometry><box><size>0.3000 0.4000 0.0500</size></box></geometry>
      </collision>
      <visual name="base_visual">
        <pose>-0.1500 0 0.0250 0 0 0</pose>
        <geometry><box><size>0.3000 0.4000 0.0500</size></box></geometry>
        <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material>
      </visual>
      <visual name="contact_visual">
        <pose>0.002 0 0.0300 0 0 0</pose>
        <geometry><box><size>0.004 0.12 0.02</size></box></geometry>
        <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script></material>
      </visual>
      <collision name="panel_collision">
        <pose>-0.3120 0 0.1425 0 0 0</pose>
        <geometry><box><size>0.0200 0.4000 0.2850</size></box></geometry>
      </collision>
      <visual name="panel_visual">
        <pose>-0.3120 0 0.1425 0 0 0</pose>
        <geometry><box><size>0.0200 0.4000 0.2850</size></box></geometry>
        <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material>
      </visual>
      <visual name="board_visual">
        <pose>-0.3010 0.0000 0.1550 0 0 0</pose>
        <geometry><box><size>0.002 0.1800 0.1800</size></box></geometry>
        <material>
          <script>
            <uri>model://aruco_dock/materials/scripts</uri>
            <uri>model://aruco_dock/materials/textures</uri>
            <name>ArucoDock/dock_a</name>
          </script>
        </material>
      </visual>
    </link>
  </model>
</sdf>
