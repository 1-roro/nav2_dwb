<?xml version="1.0"?>
<!-- make_aruco_dock.py 가 만든 설비 모형 (dock dock_b, marker 2, 3, 한 변 0.06 / 0.06 m).
     원점 = 바닥에서 도킹 면의 가운데, +x = 로봇이 다가오는 쪽, z = 위. 월드에서는 +x 가 방을 보게 놓는다.
     marker 는 x = -0.0 의 면에, 중심 높이 0.13 m -->
<sdf version="1.6">
  <model name="aruco_dock_two">
    <static>true</static>
    <link name="body">
      <collision name="machine_collision">
        <pose>-0.1770 0 0.2250 0 0 0</pose>
        <geometry><box><size>0.3500 0.5000 0.4500</size></box></geometry>
      </collision>
      <visual name="machine_visual">
        <pose>-0.1770 0 0.2250 0 0 0</pose>
        <geometry><box><size>0.3500 0.5000 0.4500</size></box></geometry>
        <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
      </visual>
      <visual name="marker_visual">
        <pose>-0.0010 0.0000 0.1300 0 0 0</pose>
        <geometry><box><size>0.002 0.2600 0.1000</size></box></geometry>
        <material>
          <script>
            <uri>model://aruco_dock_two/materials/scripts</uri>
            <uri>model://aruco_dock_two/materials/textures</uri>
            <name>ArucoDock/dock_b</name>
          </script>
        </material>
      </visual>
    </link>
  </model>
</sdf>
