        <geometry><cylinder><radius>0.035</radius><length>0.065</length></cylinder></geometry>
        <material><ambient>0.15 0.15 0.17 1</ambient><diffuse>0.15 0.15 0.17 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
