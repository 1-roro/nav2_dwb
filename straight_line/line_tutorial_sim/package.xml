<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>line_tutorial_sim</name>
  <version>0.1.0</version>
  <description>
    Offline 2D kinematic simulator that runs the straight line planner / line follower
    controller steps without Gazebo and checks the tutorial's expected results.
  </description>
  <maintainer email="user@example.com">nav2_dwb</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>straight_line_planner</depend>
  <depend>line_follower_controller</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
